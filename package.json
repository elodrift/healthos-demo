{
  "name": "healthos-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:planner": "tsx scripts/test-planner.ts",
    "test:strip": "tsx scripts/test-strip-metadata.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "verify": "npm run typecheck && npm run lint && npm run test:limits && npm run test:planner && npm run test:strip && npm run test:capture && npm run test:live && npm run test:whoop && npm run test:agent && npm run test:trace && npm run test:replan && npm run test:writable",
    "test:writable": "tsx scripts/test-profile-writable.ts",
    "test:barcode": "tsx scripts/test-barcode.ts",
    "test:replan": "tsx scripts/test-replan.ts",
    "test:live": "tsx scripts/test-live-day.ts",
    "test:whoop": "tsx scripts/test-whoop-redirect.ts",
    "test:agent": "tsx scripts/test-agent.ts",
    "test:trace": "tsx scripts/test-whoop-trace.ts",
    "test:privacy": "tsx --env-file-if-exists=.env.development.local --env-file-if-exists=.env.local scripts/test-community-privacy.ts",
    "verify:build": "npm run verify && npm run build",
    "verify:db": "npm run verify && npm run test:privacy",
    "test:capture": "tsx scripts/test-capture-time.ts",
    "audit": "node audit/audit.mjs --fail-on critical --ignore SEC001",
    "test:limits": "tsx scripts/test-rate-limit.ts"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@vercel/blob": "^2.7.0",
    "ai": "^7.0.55",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.11.9",
    "leaflet": "^1.9.4",
    "next": "14.2.35",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "swr": "2.4.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.10",
    "typescript": "^5.6.3"
  }
}

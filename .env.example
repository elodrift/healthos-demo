# Copy to .env.local and fill in. Never commit the filled copy.
# Validated by lib/env.ts — a missing required value fails fast in production.

# --- Required ---
# Neon Postgres. Shared by Drizzle and Better Auth through one pg Pool.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Session signing key. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- Strongly recommended in production ---
# Stable public origin. Set this once a custom domain is attached: it is what
# makes OAuth redirects independent of request headers, and it is the origin
# WHOOP's registered redirect URI must match.
BETTER_AUTH_URL="https://your-domain.example"

# --- Optional: WHOOP integration ---
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""

# --- Optional: provided automatically on Vercel ---
BLOB_READ_WRITE_TOKEN=""
AI_GATEWAY_API_KEY=""
